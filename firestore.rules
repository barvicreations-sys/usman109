rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // In this specific app, we trust any authenticated user who matches the admin account
      // Or we could check a collection, but for simplicity of 'admin/admin123'
      return isSignedIn();
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Students
    match /students/{studentId} {
      allow read: if true; // Public access via studentId search
      allow write: if isAdmin();
    }

    // Attendance
    match /attendance/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Reports
    match /reports/{id} {
      allow read: if true; // Public access for students
      allow write: if isAdmin();
    }

    // Finance (Income & Expense)
    match /income/{id} {
      allow read, write: if isAdmin();
    }
    match /expense/{id} {
      allow read, write: if isAdmin();
    }
  }
}
